# Sidecar WhatsApp OpenWA (Easy API) — Node 20 + Chromium sistem. Sesi disimpan di volume /data.
FROM node:20-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    CHROME_PATH=/usr/bin/chromium

RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium fonts-liberation fonts-noto-color-emoji ca-certificates curl procps tini \
      libgbm1 libasound2 libnss3 libxss1 libatk-bridge2.0-0 libgtk-3-0 libdrm2 libxkbcommon0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/openwa
COPY openwa/package.json ./package.json
RUN yarn install --ignore-engines --network-timeout 600000 && yarn cache clean

COPY deploy/openwa-entrypoint.sh /usr/local/bin/openwa-entrypoint.sh
RUN chmod +x /usr/local/bin/openwa-entrypoint.sh && mkdir -p /data

WORKDIR /data
EXPOSE 8033
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/openwa-entrypoint.sh"]
